# Neon / Postgres connection string.
# Get this from the Neon integration in your Vercel project (Storage tab),
# or from neon.tech -> your project -> Connect.
# Use the POOLED connection string (host contains "-pooler") for serverless.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
